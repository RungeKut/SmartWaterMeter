/******************************************************************
 * secrets.h.example - Пример конфигурации SmartWaterMeter
 * 
 * Скопируйте в secrets.h и отредактируйте под свои датчики.
 * secrets.h добавлен в .gitignore — не коммитьте его!
 ******************************************************************/

#ifndef secrets_h
#define secrets_h

// ======================== WiFi ========================
// Префикс для SSID точки доступа (к нему добавляется 3 байта MAC)
#define AP_SSID_PREFIX "SmartWaterMeter"
// Пароль точки доступа (пустой = открытая сеть)
#define AP_PASS_DEFAULT ""

// ======================== SMTP (email) ========================
#define SMTP_HOST_DEFAULT "smtp.yandex.ru"
#define SMTP_PORT_DEFAULT 465
#define SMTP_EMAIL_DEFAULT ""
#define SMTP_PASS_DEFAULT ""
#define SMTP_RECIPIENT_DEFAULT ""

// ======================== Периферия ========================
// Пины импульсных счётчиков (прерывания!)
#define PIN_METER_HOT 14   // D5, GPIO14 — ГВС
#define PIN_METER_COLD 12  // D6, GPIO12 — ХВС

// Коэффициент: сколько литров на один импульс
// Стандартные счётчики: 1 импульс = 1 литр (1000 imp/m3)
#define LITERS_PER_PULSE 1.0

// Пины DS18B20
#define ONE_WIRE_BUS 0     // D3, GPIO0

// Адреса датчиков DS18B20 (заполните своими!)
// Формат: {0x28, 0xXX, 0xXX, 0xXX, 0xXX, 0xXX, 0xXX, 0xXX}
// Индексы: [0]=ХВС, [1]=ГВС, [2]=Обратка, [3]=Подача
// Как узнать адреса: см. README.md раздел "Отладка"
static const uint8_t SENSOR_ADDR[4][8] = {
  {0x28, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00},  // [0] ХВС
  {0x28, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00},  // [1] ГВС
  {0x28, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00},  // [2] Обратка
  {0x28, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00, 0x00}   // [3] Подача
};

#endif